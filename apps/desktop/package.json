{
  "name": "@calendar/desktop",
  "version": "1.5.0",
  "description": "Pie - AI驱动的智能日程管理桌面应用",
  "author": "Pie Team <team@pie.app>",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "lint": "eslint . --ext .js",
    "test": "node --test src/*.test.js"
  },
  "devDependencies": {
    "electron": "^25.0.0",
    "electron-builder": "^24.0.0",
    "eslint": "^8.0.0"
  },
  "build": {
    "appId": "com.pie.app",
    "productName": "Pie",
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/sqlite3/build/Release/*.node"
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "!src/**/*.test.js",
      "icon.png"
    ],
    "extraResources": [
      {
        "from": "../renderer/dist",
        "to": "renderer",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "icon.png"
    },
    "win": {
      "target": "nsis",
      "icon": "icon.png"
    },
    "linux": {
      "target": "AppImage",
      "category": "Office",
      "icon": "icon.png"
    }
  },
  "dependencies": {
    "@ai-sdk/deepseek": "2.0.51",
    "ai": "6.0.238",
    "sqlite3": "^5.1.7",
    "zod": "4.4.3"
  }
}
