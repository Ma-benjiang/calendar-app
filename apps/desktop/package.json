{
  "name": "@calendar/desktop",
  "version": "1.0.0",
  "description": "智能日历桌面应用 - AI驱动的日程管理",
  "author": "Calendar Team <team@calendar.app>",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "lint": "eslint . --ext .js"
  },
  "devDependencies": {
    "electron": "^25.0.0",
    "electron-builder": "^24.0.0",
    "eslint": "^8.0.0"
  },
  "build": {
    "appId": "com.calendar.app",
    "productName": "日历",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "../web/dist/**/*",
      "icon.png"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": ["dmg", "zip"],
      "icon": "icon.png"
    },
    "win": {
      "target": "nsis",
      "icon": "icon.png"
    },
    "linux": {
      "target": "AppImage",
      "category": "Office",
      "icon": "icon.png"
    }
  }
}
