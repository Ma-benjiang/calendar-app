{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "removeComments": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@calendar/core": ["./packages/core/src/index.ts"],
      "@calendar/core/*": ["./packages/core/src/*"],
      "@calendar/ui": ["./packages/ui/src/index.ts"],
      "@calendar/ui/*": ["./packages/ui/src/*"],
      "@calendar/storage": ["./packages/storage/src/index.ts"],
      "@calendar/storage/*": ["./packages/storage/src/*"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
