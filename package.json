{
  "name": "pie-app",
  "version": "1.5.0",
  "private": true,
  "packageManager": "pnpm@11.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm build:desktop",
    "build:renderer": "pnpm --dir apps/renderer build",
    "build:desktop": "pnpm build:renderer && pnpm --dir apps/desktop build",
    "dev": "concurrently --kill-others-on-fail --names renderer,desktop \"pnpm dev:renderer\" \"pnpm dev:desktop\"",
    "dev:renderer": "pnpm --dir apps/renderer dev",
    "dev:desktop": "wait-on http-get://127.0.0.1:5173 && pnpm --dir apps/desktop start",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^4.0.18",
    "concurrently": "^8.2.2",
    "jsdom": "^28.1.0",
    "playwright": "^1.58.2",
    "turbo": "^1.10.0",
    "typescript": "^5.0.0",
    "vitest": "^4.0.18",
    "wait-on": "^7.2.0"
  }
}
