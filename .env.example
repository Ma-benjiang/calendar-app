# These values are optional development defaults. Users can configure models
# inside the desktop app instead.

# DeepSeek text model
VITE_DEEPSEEK_API_KEY=
VITE_DEEPSEEK_MODEL=deepseek-chat

# Volcengine Seedream image model
VITE_SEEDREAM_API_KEY=
VITE_SEEDREAM_MODEL=doubao-seedream-5-0-260128

# OpenAI-compatible image model
VITE_OPENAI_API_KEY=
