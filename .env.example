# ==========================================
# Pie Calendar App - Environment Variables
# ==========================================

# ------------------------------------------
# Daily Calendar Feature - Seedream API
# ------------------------------------------

# 火山引擎 Seedream API Key
# 获取方式: https://www.volcengine.com/docs/6394/
VITE_SEEDREAM_API_KEY=your_seedream_api_key_here

# Seedream 模型版本（可选，默认使用 doubao-seedream-5-0-260128）
VITE_SEEDREAM_MODEL=doubao-seedream-5-0-260128

# ------------------------------------------
# Development Settings
# ------------------------------------------

# 开发服务器端口
VITE_DEV_PORT=5173

# 是否启用 Mock API（用于开发测试）
VITE_ENABLE_MOCK_API=false
