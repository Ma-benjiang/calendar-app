{
  "registryVersion": "2.1.0",
  "lastUpdated": "2026-03-02T10:00:00Z",
  "subagentConfig": {
    "type": "claude-code-native",
    "location": ".claude/agents/",
    "agents": [
      "sprint-master",
      "product-owner",
      "developer",
      "qa-engineer",
      "code-reviewer",
      "bug-fixer",
      "devops"
    ]
  },
  "sprintMaster": {
    "description": "SprintMaster 负责流程协调、阶段调度和目标对齐验证",
    "phaseValidation": {
      "phase1_to_2": {
        "checkpoint": "PRD 是否包含可测试的验收标准",
        "validationRules": [
          "PRD 文档存在且非空",
          "包含功能描述章节",
          "包含验收标准章节",
          "验收标准可转化为测试用例"
        ],
        "failAction": "退回 ProductOwner 补充 PRD"
      },
      "phase2_to_3": {
        "checkpoint": "测试用例是否覆盖 PRD 所有功能点",
        "validationRules": [
          "TEST-PLAN 文档存在且非空",
          "每个功能点至少有一个测试用例",
          "测试用例包含预期结果"
        ],
        "failAction": "退回 QAEngineer 补充测试用例"
      },
      "phase3_to_4": {
        "checkpoint": "代码审查是否通过且覆盖率≥80%",
        "validationRules": [
          "CODE-REVIEW 文档存在",
          "审查结论为通过",
          "单元测试覆盖率≥80%",
          "无严重代码质量问题"
        ],
        "failAction": "退回 Developer 修复代码"
      },
      "phase4_to_5": {
        "checkpoint": "所有测试通过且无阻塞性Bug",
        "validationRules": [
          "TEST-REPORT 文档存在",
          "所有测试用例通过",
          "无 P0/P1 级别 Bug",
          "P2 Bug 有明确修复计划"
        ],
        "failAction": "启动 BugFixer 修复循环"
      },
      "phase5_to_end": {
        "checkpoint": "CEO 确认发布时机",
        "validationRules": [
          "RELEASE 文档已生成",
          "质量指标达标（覆盖率≥80%，无P0/P1 Bug）",
          "向 CEO 发送发布就绪通知",
          "CEO 明确指示 '确认发布' 后才继续"
        ],
        "notificationTemplate": "Sprint {sprintId} 已就绪发布：{feature}，质量指标：覆盖率{coverage}%，Bug：P0={p0}, P1={p1}。回复'确认发布'以继续。",
        "failAction": "暂停等待 CEO 指令"
      }
    },
    "conflictResolution": {
      "timeoutMinutes": 15,
      "escalationPath": [
        "Agent间协商 (5分钟)",
        "SprintMaster 仲裁 (10分钟)",
        "CEO 决策"
      ],
      "triggers": [
        "Developer 与 CodeReviewer 意见不一致超过15分钟",
        "涉及架构重大变更",
        "技术债务 vs 进度权衡影响 > 1个Sprint",
        "连续 2 次 SprintMaster 仲裁无法解决"
      ],
      "ceoNotification": {
        "format": "[Sprint {sprintId}] 需要决策：{conflictSummary}",
        "content": [
          "冲突背景：{background}",
          "方案A（{agentA}）：{proposalA}",
          "方案B（{agentB}）：{proposalB}",
          "SprintMaster 建议：{recommendation}",
          "影响评估：{impact}"
        ],
        "responseOptions": ["同意方案A", "同意方案B", "提出新方案"]
      }
    }
  },
  "ceoNotifications": {
    "enabled": true,
    "channels": ["cli", "report"],
    "notificationTypes": {
      "sprintStarted": {
        "enabled": true,
        "message": "Sprint {sprintId} 已启动：{feature}"
      },
      "milestoneCompleted": {
        "enabled": true,
        "message": "里程碑完成：{phase} - {feature}"
      },
      "releaseReady": {
        "enabled": true,
        "requireConfirmation": true,
        "message": "发布就绪：{feature} v{version}，质量指标：{metrics}"
      },
      "blockerIssue": {
        "enabled": true,
        "urgency": "high",
        "message": "[需关注] {sprintId} 遇到阻塞：{issue}"
      },
      "sprintCompleted": {
        "enabled": true,
        "message": "Sprint {sprintId} 已完成：{feature}",
        "attachment": "SPRINT-REPORT.md"
      }
    }
  },
